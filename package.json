{
  "name": "lanstream-pro",
  "version": "0.1.0",
  "description": "局域网视频播放和文件管理系统 - 现代界面，强大功能",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js --env=development",
    "build": "node build.js",
    "build:clean": "node build.js --clean-only",
    "build:pkg": "pkg . --output dist/LANStream-Pro.exe",
    "test": "echo \"No tests configured\" && exit 0"
  },
  "keywords": [
    "video",
    "streaming",
    "file-management",
    "lan",
    "media-server"
  ],
  "author": "KAITAO-LGit",
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "express": "^4.21.0",
    "express-rate-limit": "^7.1.5",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "redis": "^4.6.10",
    "socket.io": "^4.7.2",
    "sql.js": "^1.10.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [
      "server.js",
      "bin/**/*.js",
      "utils/**/*.js",
      "routes/**/*.js"
    ],
    "assets": [
      "public/**/*",
      "bin/ffmpeg.exe"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  }
}
